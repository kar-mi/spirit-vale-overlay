{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "paths": {
      "@svoverlay/contracts/rpc": ["./packages/contracts/rpc.ts"],
      "@svoverlay/desktop-runtime": ["./apps/desktop/src/frontend/runtime.ts"],
      "@svoverlay/desktop-runtime/view": ["./apps/desktop/src/frontend/view.ts"]
    },
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["bun"]
  }
}
