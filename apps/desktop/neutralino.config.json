{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "dev.spiritvale.overlay",
  "version": "0.10.5",
  "applicationName": "Spirit Vale Overlay",
  "author": "kar-mi",
  "description": "Spirit Vale Overlay",
  "copyright": "Copyright (C) 2026 kar-mi. Licensed under the GNU AGPL v3.",
  "applicationIcon": "resources/views/assets/app-icon.png",
  "defaultMode": "window",
  "port": 0,
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "url": "/views/launcherview/index.html",
  "documentRoot": "/resources/",
  "nativeAllowList": [
    "app.*",
    "computer.*",
    "events.*",
    "extensions.*",
    "filesystem.getStats",
    "filesystem.readBinaryFile",
    "os.execCommand",
    "os.open",
    "os.openFile",
    "os.setTray",
    "os.showFolderDialog",
    "os.showMessageBox",
    "os.showOpenDialog",
    "os.showSaveDialog",
    "window.*"
  ],
  "extensions": [
    {
      "id": "dev.spiritvale.backend",
      "commandWindows": "\"${NL_PATH}/extensions/bin/bun.exe\" --no-orphans \"${NL_PATH}/extensions/backend/index.js\""
    }
  ],
  "modes": {
    "window": {
      "title": "Spirit Vale Overlay",
      "width": 960,
      "height": 430,
      "minWidth": 900,
      "minHeight": 430,
      "borderless": true,
      "resizable": true,
      "exitProcessOnClose": true,
      "injectGlobals": true,
      "injectClientLibrary": false,
      "useLogicalPixels": false,
      "icon": "/resources/views/assets/app-icon.png"
    }
  },
  "cli": {
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0",
    "resourcesPath": "resources",
    "extensionsPath": "extensions",
    "binaryName": "spirit-vale-overlay",
    "distributionPath": "dist",
    "copyItems": [
      ".spirit-vale-portable",
      "README.txt"
    ]
  }
}
